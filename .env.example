# ============================================================
# CONFIGURAÇÕES DO PIPELINE OBSIDIAN → NOTEBOOKLM
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env — ele está no .gitignore
# ============================================================

# --- Google OAuth 2.0 ---
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_PROJECT_ID=your_project_id
GOOGLE_REDIRECT_URI=http://localhost
GOOGLE_REFRESH_TOKEN=your_refresh_token

# --- Google Service Account (alternativa ao OAuth) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account@your_project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY_ID=your_private_key_id
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# --- Google API Key ---
GOOGLE_API_KEY=your_api_key

# --- Pastas no Google Drive ---
OBSIDIAN_VAULT_FOLDER_ID=your_obsidian_drive_folder_id
NOTEBOOKLM_OUTPUTS_FOLDER_ID=your_outputs_drive_folder_id

# --- NotebookLM ---
NOTEBOOKLM_NOTEBOOK_ID=your_notebook_id

# --- GitHub (para agentes externos enviarem conteúdo via API) ---
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_REPO_OWNER=canalqb
GITHUB_REPO_NAME=OBSIDIAN
GITHUB_BRANCH=main

# --- API de Segurança (chave para autenticar agentes externos) ---
API_SECRET_KEY=your_random_secret_key_min_32_chars

# --- Google Sheets (planilha de tracking de posts) ---
GOOGLE_SHEET=your_spreadsheet_id

# --- Blogger ---
BLOGGER_BLOG_ID=your_blog_id
BLOGGER_POST_ID=your_post_id
